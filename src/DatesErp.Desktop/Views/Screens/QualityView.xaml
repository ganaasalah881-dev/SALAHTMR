<UserControl x:Class="DatesErp.Desktop.Views.Screens.QualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DatesErp.Desktop.Views.Screens"
             FlowDirection="RightToLeft">
 <!-- §v1.50.28: التدفق المعتمد — الفحص ينزل مباشرة من تسليم الإنتاج:
      ١) المصدر تسليم الإنتاج (بلا إعادة اختيار الصنف) ٢) كل الأصناف المنتَجة تنزل بكمياتها
      ٣) النتائج صفات جودة لنفس الصنف ٤) المعايير المعتمدة تظهر تلقائياً
      ٥) الحفظ يشترط: مجموع صفات كل صنف = كميته المستلمة. تدفق رأسي واحد قابل للتمرير. -->
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
 <DockPanel LastChildFill="True" Margin="12">
  <!-- ١) الترويسة -->
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
   <TextBlock Text="🔬 الفحص والجودة" FontSize="22" FontWeight="Bold" Foreground="#163B46"/>
   <TextBlock Text="أضف فحصاً لاختيار تسليم غير مفحوص، أو ابحث عن محضر سابق؛ لا تُكرر كمية الإنتاج في عمود إجمالي مستقل." Margin="0,4,0,0" Foreground="#536970"/>
  </StackPanel>

  <!-- ٢) مصدر الفحص: تسليم الإنتاج -->
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10,6" Margin="0,0,0,6">
   <StackPanel>
    <WrapPanel VerticalAlignment="Center">
     <TextBlock Text="بحث:" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
     <TextBox x:Name="SourceSearchBox" Width="190" Height="28" Padding="6,3" FontSize="12"
              ToolTip="رقم أمر الإنتاج أو العميل أو الصنف أو رقم محضر الفحص"
              KeyDown="SourceSearch_KeyDown"/>
     <Button Content="🔍 بحث" Style="{StaticResource ErpButton}" Click="SearchSources_Click" Margin="5,0,10,0"/>
     <TextBlock Text="أمر التسليم:" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
     <ComboBox x:Name="SourceBox" Width="470" SelectionChanged="Source_Changed" FontSize="12.5"
               ToolTip="بعد الضغط على إضافة اختر تسليم إنتاج لم يُفحص، أو ابحث عن محضر سابق للتعديل والطباعة"/>
     <TextBlock x:Name="ItemsCountChip" Text="0 بند محمّل" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource ErpOkBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
     <TextBlock x:Name="CheckNoChip" Text="— لا فحص محفوظ بعد" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTableHeaderBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </WrapPanel>
    <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" Margin="0,5,0,0" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}"
               Text="اختر تسليم إنتاج من الأعلى — تنزل أصنافه المنتَجة تلقائياً بكمياتها."/>
   </StackPanel>
  </Border>

  <!-- ٣) الأصناف المستلمة للفحص — نازلة تلقائياً -->
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10,5" Margin="0,0,0,6">
   <WrapPanel x:Name="ItemsPanel" VerticalAlignment="Center">
    <TextBlock Text="الأصناف المحمّلة للفحص من المصدر المحدد:" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
   </WrapPanel>
  </Border>

  <!-- ٥) معايير الفحص المعتمدة -->
  <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,6">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="معايير الفحص المعتمدة — من المواصفة القياسية المعتمدة للصنف، تُدخل نتائجها بوحدتها" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,0,4"/>
    <DataGrid x:Name="CriteriaGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              MinHeight="86" MaxHeight="120" RowHeight="30" ColumnHeaderHeight="32" FontSize="12.5"
              AlternatingRowBackground="#FBFAF5" Background="#FDFCF8" RowBackground="#FDFCF8"
              GridLinesVisibility="All" HorizontalGridLinesBrush="#94A3B8" VerticalGridLinesBrush="#94A3B8"
              HeadersVisibility="Column" BorderBrush="#94A3B8" BorderThickness="1.5" SelectionUnit="Cell"
              PreviewMouseLeftButtonDown="Grid_SingleClickEdit">
     <DataGrid.RowStyle>
         <Style TargetType="DataGridRow">
             <Setter Property="Background" Value="White"/>
             <Style.Triggers>
                 <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                     <Setter Property="Background" Value="{StaticResource InvalidRowBrush}"/>
                     <Setter Property="ToolTip" Value="{Binding ValidationError}"/>
                 </DataTrigger>
             </Style.Triggers>
         </Style>
     </DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn Header="#" Binding="{Binding LineNo}" IsReadOnly="True" Width="45">
          <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                  <Setter Property="FontWeight" Value="Bold"/>
                  <Setter Property="Foreground" Value="#475569"/>
                  <Setter Property="HorizontalAlignment" Value="Center"/>
                  <Setter Property="VerticalAlignment" Value="Center"/>
              </Style>
          </DataGridTextColumn.ElementStyle>
      </DataGridTextColumn>
      <DataGridTextColumn Header="المعيار" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
      <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitLabel}" IsReadOnly="True" Width="70"/>
      <DataGridTextColumn Header="الحد الأدنى" Binding="{Binding MinText}" IsReadOnly="True" Width="100"/>
      <DataGridTextColumn Header="الحد الأعلى" Binding="{Binding MaxText}" IsReadOnly="True" Width="100"/>
      <DataGridTextColumn Header="القياس المسجل" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
      <DataGridTextColumn Header="الحالة" Binding="{Binding StatusAr}" IsReadOnly="True" Width="120"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </Border>

  <!-- ٦) شريط الحفظ -->
  <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,0,6">
   <DockPanel>
    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
     <TextBlock x:Name="TotalsLabel" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeTableHeaderBrush}" Text="الإجمالي: —"/>
     <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
      <RadioButton x:Name="DecisionPassed" Content="✅ إفراج للمقبول" IsChecked="True" FontSize="12" Margin="0,0,10,0"/>
      <RadioButton x:Name="DecisionQuarantine" Content="⏸ تحريز مؤقت" FontSize="12" Margin="0,0,10,0"/>
      <RadioButton x:Name="DecisionRejected" Content="⛔ مرفوض" FontSize="12"/>
     </StackPanel>
    </StackPanel>
     <!-- إجراءات الحفظ والاعتماد والطباعة موجودة مرة واحدة في شريط الأدوات العام. -->
    <TextBlock Text="المعادلة: السليم + المنسم + غير المطابق = المستلم للفحص مرة واحدة؛ الإجمالي محسوب تلقائياً." FontSize="11.5" Foreground="{DynamicResource ThemeSecondaryTextBrush}" VerticalAlignment="Center" Margin="14,0,14,0" TextWrapping="Wrap"/>
   </DockPanel>
  </Border>

  <!-- ٤) نتائج الفحص — مصفوفة بنفس شكل خطة الإنتاج: صف لكل عميل×صنف×عبوة، وصفات الجودة أعمدة -->
  <Border Style="{StaticResource Card}" Background="{DynamicResource ThemeAlternateRowBrush}" MinHeight="120">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource ThemeTextBrush}"
               Text="نتائج الفحص — صف لكل عميل وصنف وعبوة؛ أدخل كل تصنيف مرة واحدة، والعمود الإجمالي محسوب آلياً وغير قابل للتحرير"/>
    <TextBlock x:Name="GradeInputsHint" DockPanel.Dock="Top" Margin="0,0,0,4" FontSize="11.5" Foreground="{StaticResource ErpOkBrush}"
               Text="اختر تسليماً غير مفحوص؛ تظهر أصنافه تلقائياً. قسّم المستلم بين «تمر سليم» و«تمر منسم» و«غير مطابق» دون تكرار الكمية."/>
    <DockPanel>
     <Border DockPanel.Dock="Bottom" Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="8,4" Margin="0,5,0,0">
      <TextBlock x:Name="EqLabel" TextWrapping="Wrap" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource ThemeTextBrush}"
                 Text="معادلة الحفظ: مجموع صفات كل صنف = الكمية المستلمة للفحص — إجمالي النتائج للقراءة فقط."/>
     </Border>
     <!-- الأعمدة الثابتة + عمود لكل صفة جودة + الإجمالي تُبنى في الكود من صفات الصنف المعرفة -->
     <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
               MinRowHeight="38" ColumnHeaderHeight="36" FontSize="13"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
               AlternatingRowBackground="#FBFAF5" Background="#FDFCF8" RowBackground="#FDFCF8"
               GridLinesVisibility="All" HorizontalGridLinesBrush="#94A3B8" VerticalGridLinesBrush="#94A3B8"
               HeadersVisibility="Column" BorderBrush="#94A3B8" BorderThickness="1.5" SelectionUnit="Cell"
               CellEditEnding="Results_CellEditEnding"
               PreparingCellForEdit="Grid_PreparingCellForEdit"
               PreviewMouseLeftButtonDown="Grid_SingleClickEdit">
               <DataGrid.RowStyle>
                   <Style TargetType="DataGridRow">
                       <Setter Property="Background" Value="White"/>
                       <Style.Triggers>
                           <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                               <Setter Property="Background" Value="{StaticResource InvalidRowBrush}"/>
                               <Setter Property="ToolTip" Value="{Binding ValidationError}"/>
                           </DataTrigger>
                       </Style.Triggers>
                   </Style>
               </DataGrid.RowStyle>
              </DataGrid>
    </DockPanel>
   </DockPanel>
  </Border>
 </DockPanel>
 </ScrollViewer>
</UserControl>
