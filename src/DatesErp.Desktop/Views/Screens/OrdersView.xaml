<UserControl x:Class="DatesErp.Desktop.Views.Screens.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="ShapeApproveButton" TargetType="Button">
            <Setter Property="Background" Value="#C9A227"/>
            <Setter Property="Foreground" Value="#2B2200"/>
            <Setter Property="BorderBrush" Value="#A8871C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D6B032"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E7E1CA"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CFC8AC"/>
                                <Setter Property="Foreground" Value="#8A8470"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShapePrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#14532D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0F3D22"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D5B3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#C7D3CB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B2C0B7"/>
                                <Setter Property="Foreground" Value="#6F7D74"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShapeSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderBrush" Value="#B8B5A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F4F2E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F4EE"/>
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- §التصميم المعتمد (production_screens_shape-2): بطاقة العمل #FDFCF8 بحواف #B8B5A0 وشريط أوامر داكن #16283C -->
    <Border Background="#FDFCF8" BorderBrush="#B8B5A0" BorderThickness="1.5" CornerRadius="6" Margin="10" SnapsToDevicePixels="True">
        <DockPanel x:Name="ListArea" LastChildFill="True">

            <!-- ① شريط الرأس الداكن المعتمد (.cmd: #16283C -> #1D3B57) -->
            <Border DockPanel.Dock="Top" BorderBrush="#0F1E2E" BorderThickness="0,0,0,1" Padding="14,9" CornerRadius="5,5,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#16283C" Offset="0"/>
                        <GradientStop Color="#1D3B57" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="MRPMPS1007" FontFamily="Consolas" FontSize="11"
                               Foreground="#CCFFFFFF" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="📝 أمر إنتاج اليوم" FontSize="15" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="#24FFFFFF" BorderBrush="#8CC9A227" BorderThickness="1"
                                CornerRadius="14" Padding="11,3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DayLabel" Text="اليوم: — — تاريخ العمل من الخادم"
                                       FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <Border Background="#FACC15" CornerRadius="12" Padding="11,3" VerticalAlignment="Center">
                            <TextBlock x:Name="DayHint"
                                       Text="ماذا سننتج اليوم؟ البيانات من الخطط المعتمدة — لا إضافة أو تعديل هنا"
                                       FontSize="11.5" FontWeight="Bold" Foreground="#3B2F00" TextWrapping="Wrap"/>
                        </Border>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- ② شريط شارات السياق البيج (.band.alt: #F4F2E8) -->
            <Border DockPanel.Dock="Top" Background="#F4F2E8" BorderBrush="#D9D4C4" BorderThickness="0,0,0,1" Padding="14,8">
                <WrapPanel VerticalAlignment="Center">
                    <Border Background="#FFF7E0" BorderBrush="#E9CE7E" BorderThickness="1" CornerRadius="13" Padding="11,3" Margin="0,0,8,2">
                        <TextBlock x:Name="DayChip" Text="📅 اليوم: —" FontSize="11.5" FontWeight="Bold" Foreground="#8A6A00"/>
                    </Border>
                    <Border Background="#EDF3EE" BorderBrush="#CADCCF" BorderThickness="1" CornerRadius="13" Padding="11,3" Margin="0,0,8,2">
                        <TextBlock x:Name="ItemsChip" Text="📦 بنود اليوم: 0" FontSize="11.5" FontWeight="Bold" Foreground="#14532D"/>
                    </Border>
                    <Border Background="#F3EEFB" BorderBrush="#D6C8EF" BorderThickness="1" CornerRadius="13" Padding="11,3" Margin="0,0,8,2">
                        <TextBlock x:Name="IssuedChip" Text="🗂 أوامر صادرة: 0" FontSize="11.5" FontWeight="Bold" Foreground="#6D28D9"/>
                    </Border>
                    <Border Background="#E8F1FA" BorderBrush="#B8CFE8" BorderThickness="1" CornerRadius="13" Padding="11,3" Margin="0,0,8,2">
                        <TextBlock x:Name="PendingChip" Text="⏳ بانتظار الإصدار: 0" FontSize="11.5" FontWeight="Bold" Foreground="#0A246A"/>
                    </Border>
                    <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="13" Padding="11,3" Margin="0,0,0,2" Visibility="Collapsed">
                        <TextBlock x:Name="DayClosedChip" Text="✔ إصدار واحد لكل مجموعة" FontSize="11.5" FontWeight="Bold" Foreground="#166534"/>
                    </Border>
                    <Border Background="#EAF0F7" BorderBrush="#A9BDD1" BorderThickness="1" CornerRadius="13" Padding="12,4" Margin="0,0,0,2">
                        <TextBlock x:Name="WorkflowStateText" Text="الخطوة الحالية: ابدأ بإضافة أمر من خطة معتمدة."
                                   FontSize="12" FontWeight="Bold" Foreground="#0A246A" TextWrapping="Wrap"/>
                    </Border>
                </WrapPanel>
            </Border>

            <!-- ③ شريط إجماليات المجموعة وحالة المعاينة — مطابق لبنية الشاشة المرجعية، دون إجراءات إصدار مكررة -->
            <Border DockPanel.Dock="Top" Background="#F4F2E8" BorderBrush="#D9D4C4" BorderThickness="0,0,0,1" Padding="14,8">
                <DockPanel LastChildFill="True">
                    <!-- عناصر التوافق محفوظة مخفية؛ الإجراء الفعلي واحد وواضح في شريط الأدوات الرئيسي. -->
                    <StackPanel Visibility="Collapsed">
                        <Button x:Name="IssueTodayBtn" Content="📤 إصدار أوامر اليوم من الخطة"
                                Style="{StaticResource ShapeApproveButton}" Click="IssueToday_Click"
                                Margin="0,0,6,2" IsEnabled="False"/>
                        <Button x:Name="IssueSelectedBtn" Content="✅ إصدار المحدد فقط"
                                Style="{StaticResource ShapeSecondaryButton}" Click="IssueSelected_Click" Margin="0,0,6,2"/>
                        <Button x:Name="ApproveSelectedBtn" Content="🔒 اعتماد الأمر المحدد"
                                Style="{StaticResource ShapeSecondaryButton}" Click="ApproveSelected_Click" Margin="0,0,6,2"/>
                        <Button x:Name="SelectAllBtn" Content="☑ تحديد الكل"
                                Style="{StaticResource ShapeSecondaryButton}" Click="SelectAll_Click" Margin="0,0,6,2"/>
                        <Button x:Name="FollowExecutionBtn" Content="🏭 متابعة تنفيذ الأمر"
                                Style="{StaticResource ShapePrimaryButton}" Click="FollowExecution_Click" Margin="0,0,0,2"/>
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="⚖ إجماليات المجموعة:" FontWeight="Bold" FontSize="12.5" Foreground="#14532D" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TotCartonsBox" Text="الكراتين: 0" FontWeight="Bold" FontSize="12" Foreground="#14532D" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="TotQtyBox" Text="الوزن: 0 كجم" FontWeight="Bold" FontSize="12" Foreground="#14532D" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="TotCustsBox" Text="عملاء: 0" FontWeight="Bold" FontSize="12" Foreground="#6D28D9" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="TotLinesBox" Text="خطوط: 0" FontWeight="Bold" FontSize="12" Foreground="#1F2937" VerticalAlignment="Center"/>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- ④ شريط الملاحظة السفلي (.note) -->
            <Border DockPanel.Dock="Bottom" Background="#F4F2E8" BorderBrush="#D9D4C4" BorderThickness="0,1,0,0" Padding="14,6" CornerRadius="0,0,5,5">
                <TextBlock Text="المعاينة لا تُصدر أمراً؛ الحفظ الصريح ينشئه من الخطة. الكراتين هي الوحدة الأساسية، والوزن للتدقيق فقط. لا يوجد استلام مخزني في هذه الشاشة."
                           FontSize="11" Foreground="#6B7280" TextWrapping="Wrap"/>
            </Border>

            <!-- ⑤ منطقة العمل الوسطى: جدول أوامر اليوم + بطاقة تفاصيل الأمر تحته في نفس الشاشة -->
            <Grid Margin="12,10,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" MinHeight="180"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.4*" MinHeight="250"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="TodayGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                          SelectionUnit="FullRow" RowHeight="32" ColumnHeaderHeight="36" FontSize="12.5" AlternationCount="2"
                          AlternatingRowBackground="#FBFAF5" Background="#FDFCF8" RowBackground="#FDFCF8"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column" BorderBrush="#B8B5A0" BorderThickness="1.5"
                          SelectionChanged="TodayGrid_SelectionChanged" MouseDoubleClick="TodayGrid_DoubleClick">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource ErpDataGridCellStyle}">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderBrush" Value="#F0EDE4"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E8F1FA"/>
                                    <Setter Property="Foreground" Value="#0A246A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#16283C"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="BorderBrush" Value="#2A4470"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ المجدول" Binding="{Binding ScheduledDate, Mode=OneWay}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="العميل 👤" Binding="{Binding CustomerName, Mode=OneWay}" Width="1.25*" MinWidth="125" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="ماذا سننتج؟ 🏷️" Width="1.5*" MinWidth="150" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" Foreground="#1F2937"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding RawName}" FontSize="10" Foreground="#667085"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="الكراتين المخططة" Binding="{Binding PlannedCartons, Mode=OneWay, StringFormat=N0}" Width="105" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الوزن (كجم) ⚖️" Binding="{Binding PlannedKg, Mode=OneWay, StringFormat=N1}" Width="105" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الوحدة 📏" Binding="{Binding Unit, Mode=OneWay}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الوردية ⏰" Binding="{Binding ShiftName, Mode=OneWay}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الخط 🏭" Binding="{Binding LineName, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="الخطة 📋" Width="1.1*" MinWidth="135" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PlanNumber}" FontFamily="Consolas" FontWeight="Bold" Foreground="#0A246A"/>
                                        <TextBlock Text="{Binding PlanTitle}" FontSize="10" Foreground="#667085"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="الأمر 📄" Binding="{Binding OrderNumber, Mode=OneWay}" Width="105" IsReadOnly="True"/>
                        <DataGridTextColumn Header="حالة التنفيذ" Binding="{Binding Status, Mode=OneWay}" Width="1.1*" MinWidth="135" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="GridEmptyHint" Grid.Row="0"
                           Text="ابدأ بزر «إضافة أمر» لاختيار خطة معتمدة غير صادرة. ستظهر هنا تفاصيلها كاملة قبل الحفظ."
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           FontSize="15" FontWeight="SemiBold" Foreground="#667085"
                           TextWrapping="Wrap" Margin="24" IsHitTestVisible="False"/>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#D9D4C4" Margin="0,3"/>

                <Border Grid.Row="2" Background="White" BorderBrush="#D9D4C4" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <TextBlock x:Name="DetailsHint"
                                   Text="اختر بنداً صادراً من الجدول أعلاه لعرض مستند الأمر وتفاصيله هنا — أو انقر مرتين لمتابعة التنفيذ وتسجيل الفعلي."
                                   Foreground="#6B7280" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="16"/>
                        <ContentControl x:Name="DetailsHost"/>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
