<UserControl x:Class="DatesErp.Desktop.Views.Screens.FGReceiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <!-- استلام الإنتاج: شاشة واحدة؛ الحفظ يرحّل مباشرة، والاعتماد النهائي يقفل السند. -->
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
                <Border Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                    <TextBlock Text="🏬 استلام الإنتاج — الحفظ يرحّل للمخزون مباشرة؛ الاعتماد النهائي يقفل السند" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTableHeaderBrush}"/>
                </Border>
                <WrapPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="المصدر:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ModeBox" Width="200" SelectionChanged="Mode_Changed"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="PickLabel" Text="أمر التسليم المحرر:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="PickBox" Width="330" SelectionChanged="Pick_Changed"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="رقم السند / رقم الترحيل:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DocNoBox" Width="220" IsReadOnly="True" Background="#F0F0F0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="تاريخ الاستلام:" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DateBox" Width="150"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="SourceHint" Text="اختر أمراً محرراً للمخزن وله كمية متبقية؛ تُرحّل الكمية مباشرة عند الحفظ." Margin="0,5,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="#536970" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource SecHeader}" Margin="-12,-12,-12,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="📋 بنود الاستلام — المنتجات التامة بالكرتون؛ المخرجات الثانوية بالكيلوجرام" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTableHeaderBrush}"/>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="⬇ تحديث المصدر" Style="{StaticResource ErpButton}" Click="Download_Click"/>
                            <Button x:Name="LegacyIssueButton" Content="إصدار سند تاريخي" Style="{StaticResource ErpButton}" Click="LegacyIssue_Click" Visibility="Collapsed"/>
                            <Button x:Name="ReceiveButton" Content="استلام متابعة تاريخية" Style="{StaticResource ErpApproveButton}" Click="Receive_Click" Visibility="Collapsed"/>
                            <Button x:Name="UnapproveButton" Content="إلغاء وعكس الأرصدة" Style="{StaticResource ErpDangerButton}" Click="Unapprove_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DataGrid x:Name="ItemsGrid" MinHeight="260" Height="400" RowHeight="32" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="#94A3B8" VerticalGridLinesBrush="#94A3B8" BorderBrush="#94A3B8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding LineNo, Mode=OneWay}" Width="45" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="تضمين" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="62"/>
                        <DataGridTextColumn Header="نوع المخرج" Binding="{Binding OutputType}" Width="105" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الصنف / المخرج" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الدفعة" Binding="{Binding LotCode}" Width="115" IsReadOnly="True"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="125" IsReadOnly="True"/>
                        <DataGridTextColumn Header="العبوة" Binding="{Binding PackagingName}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="المتاح" Binding="{Binding AvailableDisplay}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="المستلم سابقاً" Binding="{Binding ReceivedDisplay}" Width="130" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="استلام الآن" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <StackPanel x:Name="CartonPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBox Text="{Binding ReceiptPackages, UpdateSourceTrigger=PropertyChanged}" Width="78" Height="25" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="كرتون" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel x:Name="KgPanel" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                                            <TextBox Text="{Binding ReceiveNow, UpdateSourceTrigger=PropertyChanged}" Width="78" Height="25" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="كجم" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsByProduct}" Value="True">
                                            <Setter TargetName="CartonPanel" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="KgPanel" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridComboBoxColumn Header="مخزن البند" SelectedValueBinding="{Binding WarehouseId, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" Width="170"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
