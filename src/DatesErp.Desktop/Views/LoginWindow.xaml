<Window x:Class="DatesErp.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول — نظام التصنيع" Height="560" Width="880"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FlowDirection="RightToLeft">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0"/>
            <GradientStop Color="#1E293B" Offset="0.5"/>
            <GradientStop Color="#0F766E" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid>
        <!-- ═══ نافذة ERP الحديثة (تصميم موحّد، أنيق واحترافي) ═══ -->
        <Border Width="820" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.35" Color="#000000"/>
            </Border.Effect>
            <DockPanel>
                <!-- شريط العنوان -->
                <Border DockPanel.Dock="Top" Background="#0F172A" Padding="14,10" CornerRadius="7,7,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Border Width="22" Height="20" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="3" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="FakeMin_Click" ToolTip="تصغير">
                                <TextBlock Text="—" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="22" Height="20" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="3" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="FakeMax_Click" ToolTip="تكبير/استعادة">
                                <TextBlock Text="□" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="22" Height="20" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="3" Margin="2,0" Cursor="Hand" MouseLeftButtonDown="FakeClose_Click" ToolTip="إغلاق">
                                <TextBlock Text="✕" FontSize="10" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌴" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TitleBarText" Text="نظام التصنيع — تسجيل الدخول" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- جسم النافذة: الهوية + نموذج الدخول -->
                <Grid>
                    <Grid.Background>
                        <SolidColorBrush Color="#FFFFFF"/>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ لوحة الهوية (العلامة التجارية) ═══ -->
                    <Border Grid.Column="0" BorderBrush="#F1F5F9" BorderThickness="0,0,1,0" Padding="32,24" Background="#FAFAFA">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- الشعار: المرفوع من الإعدادات أو الافتراضي الذهبي -->
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                                <!-- الشعار هو العنصر البصري الرئيسي: منع الانعكاس بعرضه FlowDirection=LeftToRight -->
                                <Image x:Name="LogoImage" Width="400" Height="280" Stretch="Uniform" FlowDirection="LeftToRight"
                                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                                <Border x:Name="DefaultLogo" Width="130" Height="130" CornerRadius="20" Background="#0F766E" BorderBrush="#0D9488" BorderThickness="2">
                                    <TextBlock Text="🌴" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="CompanyNameText" Text="نظام التصنيع" FontSize="22" FontWeight="Bold"
                                       Foreground="#0F172A" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="النظام المتكامل لإدارة وتتبع عمليات التصنيع" FontSize="13.5" Foreground="#0F766E"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,14"/>
                            <Border Height="2" Width="180" Background="#0F766E" Opacity="0.3" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CompanyMetaText" Text="" FontSize="11.5" Foreground="#64748B"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ═══ نموذج الدخول ═══ -->
                    <Border Grid.Column="1" Background="#FFFFFF" Padding="28,32">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="تسجيل الدخول" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="أدخل رقم الموظف أو اسم المستخدم للدخول" FontSize="11.5" Foreground="#64748B" Margin="0,0,0,18" TextWrapping="Wrap"/>

                            <TextBlock Text="رقم الدخول (أو اسم المستخدم)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="UserNameBox" TabIndex="0" Height="34" ToolTip="أدخل رقم الدخول الخاص بك — كل موظف له رقم"/>

                            <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <PasswordBox x:Name="PasswordBox" TabIndex="1" Height="34" KeyDown="PasswordBox_KeyDown" PasswordChanged="PasswordBox_Changed"/>
                                <TextBox x:Name="PasswordText" TabIndex="1" Height="34" Visibility="Collapsed" TextChanged="PasswordText_Changed"/>
                            </Grid>
                            <CheckBox x:Name="ShowPassChk" Content="👁 إظهار كلمة السر أثناء الكتابة" Margin="0,8,0,0" Checked="ShowPass_Toggled" Unchecked="ShowPass_Toggled"/>

                            <CheckBox x:Name="RememberMe" Content="تذكرني على هذا الجهاز" Margin="0,12,0,0" TabIndex="2"/>

                            <Button x:Name="LoginBtn" Content="🔐 تسجيل الدخول" Style="{StaticResource ErpPrimaryButton}"
                                    Height="38" Margin="0,20,0,0" HorizontalAlignment="Stretch" Click="Login_Click" TabIndex="3" IsDefault="True"/>

                            <TextBlock x:Name="MsgText" Text="" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,12,0,0"
                                       HorizontalAlignment="Center" FontSize="12" TextAlignment="Center"/>

                            <!-- طوارئ المدير -->
                            <Button x:Name="EmergencyBtn" Content="🔓 فك قفل حساب المدير — طوارئ" Style="{StaticResource ErpButton}"
                                    Height="32" Margin="0,12,0,0" HorizontalAlignment="Stretch" FontSize="11.5" Click="EmergencyUnlock_Click"
                                    ToolTip="يفك قفل حساب المدير فوراً ويعيد كلمة المرور إلى [REDACTED-DEFAULT-CREDENTIAL]"/>
                            <TextBlock x:Name="DbHintText" Text="" Foreground="#64748B" TextWrapping="Wrap" Margin="0,12,0,0"
                                       HorizontalAlignment="Center" FontSize="11" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <!-- شريط سفلي: اسم النظام والإصدار -->
        <TextBlock Text="نظام التصنيع — النظام المتكامل لإدارة عمليات التصنيع © 2026" Foreground="#94A3B8" FontSize="11.5"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
    </Grid>
</Window>
