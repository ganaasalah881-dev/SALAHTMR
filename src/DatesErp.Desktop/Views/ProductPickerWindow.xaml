<Window x:Class="DatesErp.Desktop.Views.ProductPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بحث واختيار صنف" Width="980" Height="620" MinWidth="850" MinHeight="500"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}" ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- بطاقة البحث العلوية -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="📦" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="دليل الأصناف — البحث والاختيار" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource ThemeTableHeaderBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Left" Background="#F1F5F9" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                        <TextBlock x:Name="CountText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                    </Border>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ابحث هنا:" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Margin="0,0,10,0" Foreground="{DynamicResource ThemeTextBrush}"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" FontSize="13.5" Height="36" Padding="10,6" TextChanged="SearchBox_TextChanged"
                             ToolTip="اكتب كود الصنف أو اسمه — مثال: 001 أو خلاص أو سكري" VerticalContentAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- جدول الأصناف الموسّع -->
        <Border Grid.Row="1" Style="{StaticResource WhiteCard}" Margin="0,0,0,12" Padding="0">
            <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      RowHeight="36" FontSize="13" CanUserAddRows="False"
                      MouseDoubleClick="ProductsGrid_DoubleClick"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderThickness="0" Background="{DynamicResource ThemeTableBackgroundBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="كود الصنف" Binding="{Binding ProductCode}" Width="120"/>
                    <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductNameAr}" Width="*"/>
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitOfMeasure}" Width="90"/>
                    <DataGridTextColumn Header="المجموعة" Binding="{Binding GroupCode}" Width="90"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding ItemType}" Width="90"/>
                    <DataGridTextColumn Header="العبوة الافتراضية" Binding="{Binding DefaultPackName}" Width="140"/>
                    <DataGridTextColumn Header="وزن العبوة (كجم)" Binding="{Binding CartonWeightKg, StringFormat=N2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- الأزرار السفلية والتلميحات -->
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Right" Text="💡 تلميح: اضغط Enter أو نقر مزدوج للاختيار الفوري للصنف المحدد."
                       VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="✅ اختيار الصنف" Style="{StaticResource ErpPrimaryButton}" Width="130" Height="34" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"/>
                <Button Content="✖ إلغاء" Style="{StaticResource ErpButton}" Width="90" Height="34" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
