<Window x:Class="DatesErp.Desktop.Views.FinishedBatchPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختيار دفعة تامة للتسليم — جميع الأرصدة المتاحة معروضة فوراً"
        Width="1220" Height="680" MinWidth="1050" MinHeight="520"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}" ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- بطاقة البحث والتصفية -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock Text="📦" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="جميع الأرصدة التامة المتاحة — اختر دفعة للتسليم (مرتبة FIFO)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeTableHeaderBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Left" Background="#F1F5F9" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3">
                        <TextBlock x:Name="CountText" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
                    </Border>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="تصفية سريعة:" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Margin="0,0,10,0" Foreground="{DynamicResource ThemeTextBrush}"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" FontSize="13" Height="36" Padding="10,6" TextChanged="SearchBox_TextChanged"
                             ToolTip="ابحث باسم العميل أو اسم الصنف أو رقم الدفعة" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="عرض الكل" Style="{StaticResource ErpButton}" Margin="10,0,0,0" Height="36" Width="95" Click="ShowAll_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- جدول الأرصدة التامة الموسع -->
        <Border Grid.Row="1" Style="{StaticResource WhiteCard}" Margin="0,0,0,12" Padding="0">
            <DataGrid x:Name="BatchesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      RowHeight="36" FontSize="13" CanUserAddRows="False"
                      MouseDoubleClick="BatchesGrid_DoubleClick"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderThickness="0" Background="{DynamicResource ThemeTableBackgroundBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="تاريخ الإنتاج" Binding="{Binding ProductionDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="160"/>
                    <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding LotCode}" Width="120"/>
                    <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="130"/>
                    <DataGridTextColumn Header="الرصيد (كرتون)" Binding="{Binding Packages, StringFormat=N0}" Width="110"/>
                    <DataGridTextColumn Header="الرصيد (كجم)" Binding="{Binding Qty, StringFormat=N1}" Width="110"/>
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding Unit}" Width="80"/>
                    <DataGridTextColumn Header="العبوة" Binding="{Binding PackName}" Width="110"/>
                    <DataGridTextColumn Header="الصفة" Binding="{Binding Grade}" Width="95"/>
                    <DataGridTextColumn Header="أيام بالمخزن" Binding="{Binding StorageDays}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- الأزرار السفلية والتلميحات -->
        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Right" Text="💡 تلميح: انقر نقراً مزدوجاً على الدفعة لاختيارها فوراً وتنزيلها لإذن التسليم."
                       VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ThemeSecondaryTextBrush}"/>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="✅ اختيار الدفعة" Style="{StaticResource ErpPrimaryButton}" Width="130" Height="34" Margin="0,0,10,0" Click="Ok_Click" IsDefault="True"/>
                <Button Content="✖ إلغاء" Style="{StaticResource ErpButton}" Width="90" Height="34" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
